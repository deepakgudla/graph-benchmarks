# Copy to .env and fill in, then `set -a && source .env && set +a` before
# running the benchmark. Never commit the real .env file.

# CognoDB Cloud (from the console, shown once at instance creation)
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# Neo4j AuraDB Free
AURA_URI=neo4j+s://<instance-id>.databases.neo4j.io
AURA_USER=neo4j
AURA_PASSWORD=

# Memgraph Cloud
MEMGRAPH_URI=bolt+s://<instance-id>.memgraph.cloud:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# ArangoDB Oasis
ARANGO_URI=https://<instance-id>.arangodb.cloud:8529
ARANGO_USER=root
ARANGO_PASSWORD=

